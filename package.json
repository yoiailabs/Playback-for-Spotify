{
  "name": "playback",
  "author": "alex_pavlov",
  "version": "1.4.0",
  "license": "MIT",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "jpeg-js": "^0.4.4"
  },
  "pebble": {
    "displayName": "Ongaku for Spotify",
    "uuid": "c5d2c288-0e8b-4b80-bd43-530bb57bb7f5",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "basalt",
      "diorite",
      "emery",
      "flint",
      "aplite",
      "gabbro",
      "chalk"
    ],
    "watchapp": {
      "watchface": false,
      "iconResourceId": "IMAGE_MENU_ICON"
    },
    "capabilities": ["configurable"],
    "messageKeys": {
      "ImageWidth": 0,
      "ImageHeight": 1,
      "ImageDataSize": 2,
      "ImageChunksTotal": 3,
      "ImageChunkIndex": 4,
      "ImageChunkData": 5,
      "ImageSlot": 6,
      "ImagePromote": 7,
      "PrefetchAbort": 8,
      "RequestArtist": 10,
      "RequestAlbum": 11,
      "JsReady": 20,
      "ErrorMsg": 21,
      "StatusMsg": 22,
      "Command": 100,
      "CommandContext": 101,
      "TrackTitle": 120,
      "TrackArtist": 121,
      "TrackDuration": 123,
      "TrackElapsed": 124,
      "TrackIsPlaying": 125,
      "ShuffleState": 126,
      "AuthStatus": 127,
      "RepeatState": 128,
      "ListType": 140,
      "ListCount": 141,
      "ListIndex": 142,
      "ListItemTitle": 143,
      "ListItemSubtitle": 144,
      "ListItemUri": 145,
      "ListDone": 146
    },
    "resources": {
      "media": [
        {
          "menuIcon": true,
          "type": "bitmap",
          "name": "IMAGE_MENU_ICON",
          "file": "icon.png"
        }
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "acorn": "8.19.0",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "patch-package": "8.0.1",
    "wrangler": "4.160.1"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "test": "npm run test:js && npm run test:c",
    "test:js": "node --test test/js/*.test.cjs",
    "lint": "eslint .",
    "test:c": "sh scripts/test-c.sh",
    "lint:c": "python3 scripts/lint-c.py"
  }
}
