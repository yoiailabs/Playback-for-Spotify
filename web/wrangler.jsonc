{
  // Reusing the name intentionally takes over the existing Worker and domain.
  "name": "ongaku",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "ongaku.yoiailabs.com", "custom_domain": true }]
}
